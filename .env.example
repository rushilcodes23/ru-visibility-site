# Cloudflare Web Analytics beacon token — from the Cloudflare dashboard
# (Analytics & Logs -> Web Analytics -> Add a site). This is a NEXT_PUBLIC_
# variable, meaning Next.js inlines it into the client bundle at build time,
# not at runtime. It must be set in .env.local before `npm run build` /
# `npm run deploy` runs — setting it only as a `wrangler secret` will not
# work, since that's a server-side runtime value and this needs to exist in
# the browser-shipped JS.
NEXT_PUBLIC_CF_BEACON_TOKEN=
