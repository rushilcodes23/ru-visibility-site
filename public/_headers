# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# Static assets are served directly by Cloudflare and never touch the
# Next.js server, so next.config.ts's headers() doesn't apply to them.
# Keep this list in sync with SECURITY_HEADERS in next.config.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Files in /public are served under their own name with no content hash, so
# they cannot be immutable — a logo change has to be able to reach people.
# A week of browser caching with a day of stale-while-revalidate keeps repeat
# visits instant without pinning a stale logo for a year. Lighthouse flagged
# these as having no usable cache lifetime at all.
/*.png
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

/*.txt
  Cache-Control: public,max-age=86400
